<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GitExtensions.Avalonia.MainWindow"
        Title="GitExtensions"
                Width="1100"
                Height="700"
                MinWidth="720"
                MinHeight="480"
                SystemDecorations="None"
                Background="{DynamicResource ShellInteriorBrush}"
                >
        <Grid RowDefinitions="52,*,30" ColumnDefinitions="56,*,56">
                <Border Grid.Row="0" Grid.ColumnSpan="3" Background="{DynamicResource ShellHeaderBrush}" BorderBrush="{DynamicResource ShellSeparatorBrush}" BorderThickness="0,0,0,1" PointerPressed="WindowPointerPressed">
                        <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="GitExtensions" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="18,0" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="MinimizeButton" Classes="chrome-button" ToolTip.Tip="{Binding Localization[Minimize]}" Click="MinimizeClick">
                                                <PathIcon Data="{DynamicResource MinimizeGeometry}" Width="16" Height="16" />
                                        </Button>
                                        <Button x:Name="MaximizeButton" Classes="chrome-button" ToolTip.Tip="{Binding Localization[MaximizeOrRestore]}" Click="MaximizeClick">
                                                <PathIcon Data="{DynamicResource MaximizeGeometry}" Width="16" Height="16" />
                                        </Button>
                                        <Button Classes="chrome-button" ToolTip.Tip="{Binding Localization[Close]}" Click="CloseClick">
                                                <PathIcon Data="{DynamicResource CloseGeometry}" Width="16" Height="16" />
                                        </Button>
                                </StackPanel>
                        </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource ShellRailBrush}" BorderThickness="0">
                        <StackPanel HorizontalAlignment="Center" Margin="0,12">
                                <Button Classes="rail-button" ToolTip.Tip="{Binding Localization[Welcome]}" Command="{Binding ShowWelcomeCommand}">
                                        <PathIcon Data="{DynamicResource WelcomeGeometry}" Width="28" Height="28" />
                                </Button>
                                <Button Classes="rail-button" ToolTip.Tip="{Binding Localization[OpenRepository]}" Command="{Binding OpenFolderCommand}">
                                        <PathIcon Data="{DynamicResource OpenRepositoryGeometry}" Width="28" Height="28" />
                                </Button>
                        </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource ShellInteriorBrush}" Padding="28,24">
                        <Grid RowDefinitions="Auto,*">
                                <StackPanel IsVisible="{Binding IsWelcome}">
                                        <TextBlock Text="{Binding Localization[OpenRepository]}" FontSize="28" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Localization[ChooseRecentRepository]}" Opacity="0.72" Margin="0,8,0,20" />
                                        <Button Content="{Binding Localization[BrowseForFolder]}" Command="{Binding OpenFolderCommand}" HorizontalAlignment="Left" />
                                        <TextBlock Text="{Binding Localization[RecentRepositories]}" FontSize="17" FontWeight="SemiBold" Margin="0,32,0,10" />
                                        <ItemsControl ItemsSource="{Binding RecentRepositories}">
                                                <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                                <Button Content="{Binding Path}" Command="{Binding $parent[ItemsControl].DataContext.OpenRecentCommand}" CommandParameter="{Binding}" HorizontalContentAlignment="Left" Margin="0,3" />
                                                        </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                </StackPanel>

                                <StackPanel Grid.Row="1" IsVisible="{Binding IsBusy}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ProgressBar IsIndeterminate="True" Width="240" />
                                        <TextBlock Text="{Binding Localization[OpeningRepository]}" HorizontalAlignment="Center" Margin="0,12" />
                                </StackPanel>

                                <Grid Grid.Row="1" IsVisible="{Binding HasRepository}" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
                                        <TextBlock Text="{Binding Localization[Repository]}" FontSize="28" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="1" Text="{Binding ActiveRepository.Path}" TextWrapping="Wrap" Opacity="0.75" />
                                        <TextBlock Grid.Row="2" Text="{Binding BranchSummary}" Margin="0,18,0,0" />
                                        <TextBlock Grid.Row="3" Text="{Binding RemotesSummary}" />
                                        <TextBlock Grid.Row="4" Text="{Binding ActiveRepository.WorkingTreeSummary}" />

                                        <Grid Grid.Row="5" Margin="0,16,0,0">
                                                <StackPanel IsVisible="{Binding CommitList.IsLoading}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <ProgressBar IsIndeterminate="True" Width="200" />
                                                        <TextBlock Text="{Binding Localization[LoadingCommits]}" HorizontalAlignment="Center" Margin="0,10" />
                                                </StackPanel>

                                                <TextBlock IsVisible="{Binding CommitList.IsEmpty}" Text="{Binding Localization[NoCommits]}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" />

                                                <StackPanel IsVisible="{Binding CommitList.HasCommitError}" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CommitList.ErrorMessage}" TextWrapping="Wrap" />
                                                        <Button Content="{Binding Localization[Retry]}" Command="{Binding CommitList.RetryCommand}" HorizontalAlignment="Center" />
                                                </StackPanel>

                                                                                                <ListBox IsVisible="{Binding CommitList.IsLoaded}" ItemsSource="{Binding CommitList.Commits}">
                                                                                                                <ListBox.ItemsPanel>
                                                                                                                                <ItemsPanelTemplate>
                                                                                                                                                <VirtualizingStackPanel Orientation="Vertical" />
                                                                                                                                </ItemsPanelTemplate>
                                                                                                                </ListBox.ItemsPanel>
                                                        <ListBox.ItemTemplate>
                                                                <DataTemplate>
                                                                                                                                                <Grid Height="28" ColumnDefinitions="88,150,160,*">
                                                                                <TextBlock Text="{Binding ShortId}" FontFamily="monospace" />
                                                                                <TextBlock Grid.Column="1" Text="{Binding Date}" />
                                                                                <TextBlock Grid.Column="2" Text="{Binding Author}" TextTrimming="CharacterEllipsis" />
                                                                                <TextBlock Grid.Column="3" Text="{Binding Subject}" TextTrimming="CharacterEllipsis" />
                                                                        </Grid>
                                                                </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                </ListBox>
                                        </Grid>
                                </Grid>

                                <StackPanel Grid.Row="1" IsVisible="{Binding HasError}" Spacing="10" Margin="0,220,0,0">
                                        <TextBlock Text="{Binding Localization[UnableToOpenRepository]}" FontSize="20" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="{Binding Localization[Retry]}" Command="{Binding RetryCommand}" />
                                                <Button Content="{Binding Localization[ChooseAnotherFolder]}" Command="{Binding OpenFolderCommand}" />
                                        </StackPanel>
                                </StackPanel>
                        </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource ShellRailBrush}" BorderThickness="0">
                        <StackPanel HorizontalAlignment="Center" Margin="0,12">
                                <Button Classes="rail-button" ToolTip.Tip="{Binding Localization[RepositoryInformation]}" IsEnabled="{Binding HasRepository}" Command="{Binding ShowRepositoryInformationCommand}">
                                        <PathIcon Data="{DynamicResource RepositoryInformationGeometry}" Width="28" Height="28" />
                                </Button>
                        </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.ColumnSpan="3" Background="{DynamicResource ShellHeaderBrush}" BorderBrush="{DynamicResource ShellSeparatorBrush}" BorderThickness="0,1,0,0" Padding="12,0">
                        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="12" Opacity="0.76" />
                </Border>
        </Grid>
</Window>
